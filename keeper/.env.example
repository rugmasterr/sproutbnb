# ---- required (keeper idles in "not configured" mode until these are set) ----
# comma-separated = fallback
BSC_RPC_URL=https://bsc-rpc.publicnode.com,https://bsc-dataseed.bnbchain.org
# SproutVaultFactory (Roots/Payouts are read from it)
SPROUT_FACTORY=
# SECRET — fly secrets set; must equal SproutRoots.keeper() and SproutPayouts.keeper()
KEEPER_PRIVATE_KEY=

# ---- mode ----
CHAIN_ID=56
# simulate everything, send nothing; 1Click quotes are dry
DRY_RUN=true
# (DRY_RUN without a key: simulate as this address)
# KEEPER_ADDRESS=0x…
# (one loop, then exit (cron / CI))
# RUN_ONCE=true
LOOP_INTERVAL_SEC=60
STATE_DIR=./state
PORT=8080
LOG_LEVEL=info
# exit (fly restarts) if one loop runs longer than this
WATCHDOG_SEC=1800

# ---- slippage & gas ----
# applied to QuoterV2 / Portal quotes
SLIPPAGE_BPS=100
# extra haircut on $SPROUT quotes (2% Flap tax token)
SPROUT_TAX_BPS=200
GAS_WARN_BNB=0.02
# below this the keeper stops sending
GAS_RESERVE_BNB=0.002
MAX_GAS_PRICE_GWEI=5

# ---- thresholds ----
FLUSH_MIN_BNB=0.002
BURN_MIN_BNB=0.01
LIQUIDITY_MIN_BNB=0.02
# modes 0/1/2
SETTLE_MIN_ZEC=0.005
# per settle (V3 ZEC/WBNB pool is shallow)
SETTLE_MAX_BNB=1
# modes 3/4: bridge when ≈0.25 ZEC …
BRIDGE_MIN_ZEC=0.25
# … or ≥0.01 ZEC and
BRIDGE_DUST_ZEC=0.01
# ≥7 days since the last bridge
BRIDGE_DUST_AFTER_DAYS=7
BRIDGE_DEADLINE_MIN=60
# largest single 1Click quote; > MAX_BRIDGE (1 BNB) → FLEX_INPUT funded by several equal bridgeOut calls
BRIDGE_MAX_QUOTE_BNB=3
# reject 1Click quotes >10% below the on-chain ZEC price
BRIDGE_MAX_SHORTFALL_BPS=1000
# (default: keeper address)
# BRIDGE_REFUND_TO=0x…
# (default true on mainnet, false on testnet)
# BRIDGE_ENABLED=true

# ---- NEAR Intents 1Click ----
# (alias ONECLICK_URL)
ONECLICK_BASE=https://1click.chaindefuser.com/v0
# asset ids (defaults: native ZEC on Zcash / native BNB on BSC)
# ONECLICK_ZEC_ASSET=nep141:zec.omft.near
# ONECLICK_BNB_ASSET=nep245:v2_1.omni.hot.tg:56_11111111111111111111
# (SECRET, optional partner key (sent as X-API-Key); without it 1Click adds 0.25%)
# ONECLICK_JWT=
ONECLICK_REFERRAL=sprout
ONECLICK_SLIPPAGE_BPS=100

# ---- shield forwarder (zforward/) for zs1/u1 recipients ----
# FORWARDER_URL=http://sprout-zforward.internal:8080
# (SECRET)
# FORWARDER_TOKEN=
# (optional; else GET /v1/info)
# FORWARDER_TADDR=t1…

# ---- holder rewards (mode 2) ----
# auto|on|off — Sprout-run merkle distributor when the Flap dividend tracker is unusable
HOLDER_FALLBACK=auto
HOLDER_EPOCH_MIN_ZEC=0.05
HOLDER_EPOCH_INTERVAL_SEC=3600
# (tokens; default = dividend.minimumShareBalance() or 100,000)
# HOLDER_MIN_BALANCE=100000
HOLDER_LOG_CHUNK=5000
HOLDER_MAX_SCAN_BLOCKS=200000

# (required on testnet (mainnet default 0xB048…5997))
# QUOTER_V2=0x…

# ---- misc ----
# planted vaults read per factory.getPlantings page
# PLANTINGS_PAGE=100
# PancakeSwap V3 ZEC/WBNB pool fee tier (2500 = the 0.25% pool)
# ZEC_V3_FEE=2500
