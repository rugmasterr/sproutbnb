# Sprout passkey relayer (fly.io app). NO SECRETS IN THIS FILE — set secrets with `fly secrets set NAME=...`.
# With the core three missing the relayer idles: /healthz answers 200 and lists what is missing, /relay and
# /quote-gas return 503 "not configured".

# ---- core (required to relay) ----
# single http(s) URL
BSC_RPC_URL=https://bsc-rpc.publicnode.com
# SECRET: the relayer's hot wallet (pays gas, is reimbursed in-tx by each account). Keep it topped up with a little BNB.
RELAYER_PRIVATE_KEY=
# SproutAccountFactory address (alias: NEXT_PUBLIC_SPROUT_ACCOUNT_FACTORY)
SPROUT_ACCOUNT_FACTORY=
CHAIN_ID=56
PORT=8080

# ---- web ----
# comma-separated; default https://sproutbnb.cash,https://www.sproutbnb.cash,http://localhost:3000 (no *.vercel.app)
ALLOWED_ORIGINS=
# client IP source: fly (Fly-Client-IP; default on fly) | xff (right-most X-Forwarded-For) | off
TRUST_PROXY=

# ---- shield forwarder (zforward) — needed for POST /shield-request ----
FORWARDER_URL=http://sprout-zforward.internal:8080
# SECRET, >= 24 chars, same value as zforward's FORWARDER_TOKEN
FORWARDER_TOKEN=
FORWARDER_REQUEST_PATH=/v1/requests
# forwarder t-address (alias NEXT_PUBLIC_FORWARDER_TADDR); else read from zforward /v1/info
FORWARDER_TADDR=
# on: check every shield request's quote with 1Click (recipient = forwarder t-address, native ZEC, <= SHIELD_MAX_ZEC)
SHIELD_VERIFY_QUOTE=on
SHIELD_MAX_ZEC=100
ONECLICK_BASE=https://1click.chaindefuser.com/v0
# SECRET, optional 1Click partner key
ONECLICK_JWT=

# ---- gas policy (defaults shown) ----
MAX_GAS_PRICE_GWEI=3
MIN_GAS_PRICE_GWEI=0.05
GAS_PRICE_BUMP_BPS=0
QUOTE_MARGIN_BPS=1500
RELAY_MIN_MARGIN_BPS=500
VERIFY_OVERHEAD_GAS=65000
DEPLOY_OVERHEAD_GAS=150000
MAX_GAS_PER_TX=4000000
MAX_CALLS=16
MAX_CALLDATA_BYTES=48000
DEADLINE_MIN_SEC=20
DEADLINE_MAX_SEC=3600
DEADLINE_SUGGEST_SEC=600
MIN_RELAYER_BALANCE_BNB=0.005

# ---- stuck transactions ----
STUCK_AFTER_SEC=45
REPLACE_BUMP_BPS=2500
MAX_PENDING_TXS=24
MONITOR_INTERVAL_SEC=6

# ---- abuse limits ----
# BNB the relayer may lose to reverts per rolling hour before tightening / refusing
REVERT_BUDGET_BNB_PER_HOUR=0.01
IP_STRIKES_PER_HOUR=5
# requests per minute
RL_RELAY_PER_IP=12
RL_RELAY_PER_ACCOUNT=6
RL_QUOTE_PER_IP=60
RL_SHIELD_PER_IP=10
RL_READ_PER_IP=240
RL_QUOTE_GLOBAL=600
RL_RELAY_GLOBAL=240
