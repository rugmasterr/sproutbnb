# Sprout site (Next.js on Vercel). Copy to .env.local for local dev, or set these in Vercel → Settings → Environment
# Variables. NO SECRETS IN THIS FILE. Every value is optional: with nothing set the site renders an honest
# pre-launch state (configured:false, zeros, Zcash Foundation option disabled).
#
# NEXT_PUBLIC_* values are baked into the browser bundle at build time — redeploy after changing them.

# ---- chain ----
# 56 = BNB Chain mainnet, 97 = testnet
NEXT_PUBLIC_CHAIN_ID=56
# browser RPC (public; default https://bsc-rpc.publicnode.com)
NEXT_PUBLIC_BSC_RPC_URL=
# server-side RPC for API routes (may be a private URL with a key — then mark it Sensitive in Vercel)
BSC_RPC_URL=
# server-side RPC used for eth_getLogs scans (defaults per chain); some public RPCs cap log ranges
BSC_LOGS_RPC_URL=

# ---- Sprout core contracts (contracts/script/Deploy.s.sol prints these) ----
NEXT_PUBLIC_SPROUT_FACTORY=
NEXT_PUBLIC_SPROUT_ROOTS=
NEXT_PUBLIC_SPROUT_PAYOUTS=
NEXT_PUBLIC_SPROUT_TERMINAL=
# $SPROUT token (contracts/script/LaunchSprout.s.sol), set after launch
NEXT_PUBLIC_SPROUT_TOKEN=
# block the factory was deployed at (speeds up log scans for Nodes/ledger)
NEXT_PUBLIC_FACTORY_START_BLOCK=
# override BEP-20 ZEC (default: mainnet Binance-Peg ZEC 0x1Ba42e5193dfA8B03D15dd1B86a3113bbBEF8Eeb; testnet: your mock)
NEXT_PUBLIC_ZEC_TOKEN=

# ---- passkey Sprout Accounts (accounts/script/DeployAccounts.s.sol) ----
NEXT_PUBLIC_SPROUT_ACCOUNT_FACTORY=
# optional: SproutAccountFactory.implementation() — lets the browser compute the account address without an RPC call
NEXT_PUBLIC_SPROUT_ACCOUNT_IMPL=
# optional WebAuthn RP ID so www. and the apex share one passkey (registrable domain only)
NEXT_PUBLIC_PASSKEY_RP_ID=sproutbnb.cash
# relayer (fly.io), e.g. https://sprout-relayer.fly.dev — passkey transactions are disabled until set
NEXT_PUBLIC_RELAYER_URL=

# ---- Zcash ----
# Sprout shield forwarder's transparent address (zforward GET /v1/info). Shielded cash-out stays disabled until this,
# NEXT_PUBLIC_RELAYER_URL and NEXT_PUBLIC_SPROUT_TERMINAL are all set.
NEXT_PUBLIC_FORWARDER_TADDR=
# SERVER SECRET (set in Vercel as Sensitive, never commit): optional NEAR Intents 1Click partner key, sent as X-API-Key.
# Without it 1Click adds 0.25% per swap.
ONECLICK_JWT=

# ---- tuning (server, optional) ----
# blocks of trade history the feeds scan (default 2400)
SPROUT_TRADES_WINDOW=
# blocks the Nodes ledger scans (default 200000) and per-request log chunk (default 40000)
SPROUT_LEDGER_WINDOW=
SPROUT_LOG_CHUNK=
