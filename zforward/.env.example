# Sprout shield forwarder (fly.io, internal-only). NO SECRETS IN THIS FILE — `fly secrets set NAME=...`.
# Without ZCASH_SEED / WALLET_DIR / LIGHTWALLETD_URL / FORWARDER_TOKEN only /healthz and /status answer and
# registrations get 503 (idle mode).

PORT=8080
HOST=::
NODE_ENV=production

# ---- Zcash wallet (zcash-devtool) ----
ZCASH_NETWORK=mainnet
# SECRET: 24-word BIP-39 phrase of the forwarder's dedicated hot wallet (never reuse a personal wallet)
ZCASH_SEED=
# block height the wallet was created at (restores fast)
ZCASH_BIRTHDAY=
WALLET_DIR=/data/wallet
# optional age identity file for the wallet (default: created in WALLET_DIR)
WALLET_IDENTITY=
LIGHTWALLETD_URL=zec.rocks:443
# direct | tor | socks5://host:port
ZCASH_CONNECTION=direct
ZCASH_DEVTOOL_BIN=zcash-devtool
WALLET_TIMEOUT_MS=900000
WALLET_RUST_LOG=warn
# mock = in-memory wallet for local smoke runs only (refused on mainnet production)
WALLET_KIND=
STATE_FILE=/data/zforward-state.json

# ---- API ----
# SECRET, >= 24 chars; shared with relayer + keeper (their FORWARDER_TOKEN)
FORWARDER_TOKEN=
# SECRET, optional, >= 24 chars, != FORWARDER_TOKEN: enables POST /v1/admin/requests/:quoteRef/requeue
ADMIN_TOKEN=
# expected t-address of the wallet; the service pauses if the seed derives a different one (wrong-seed guard).
# Publish the same value as the site's NEXT_PUBLIC_FORWARDER_TADDR.
FORWARDER_TADDR=

# ---- on-chain proof (BSC) ----
# single http(s) URL (not a comma list)
BSC_RPC_URL=https://bsc-rpc.publicnode.com
# emitters of CashOut / BridgedOut (aliases NEXT_PUBLIC_SPROUT_TERMINAL / NEXT_PUBLIC_SPROUT_PAYOUTS)
SPROUT_TERMINAL=
SPROUT_PAYOUTS=
# required | off (off is refused on mainnet production unless ALLOW_NO_PROOF=1)
ONCHAIN_PROOF=required
ALLOW_NO_PROOF=
# 1 = CashOut payouts must use the binding quoteRef keccak256("sprout-shield:v1:<lower deposit>:<shielded addr>"),
# which is what the site sends. fly.toml sets 1.
REQUIRE_BOUND_QUOTEREF=1

# ---- 1Click ----
ONECLICK_BASE=https://1click.chaindefuser.com/v0
# SECRET, optional
ONECLICK_JWT=

# ---- limits & fees (SPEC: <=100 ZEC per payout, <=1000 ZEC and <=2000 payouts per day) ----
MAX_PAYOUT_ZEC=100
MAX_DAILY_ZEC=1000
MAX_DAILY_PAYOUTS=2000
FEE_RESERVE_ZEC=0.0004
SEND_FEE_HEADROOM_ZEC=0.0002
MIN_PAYOUT_ZEC=0.0005
TICK_MS=30000
EXPIRE_GRACE_MS=86400000
# 1 = stop sending (registrations and matching continue)
PAUSE_SENDS=
LOG_LEVEL=info
